{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "NIXPACKS",
    "buildCommand": "npm ci --prefix frontend && npm run build --prefix frontend && npm ci --prefix backend"
  },
  "deploy": {
    "startCommand": "npm start --prefix backend",
    "healthcheckPath": "/api/salud",
    "restartPolicyType": "ON_FAILURE"
  }
}
